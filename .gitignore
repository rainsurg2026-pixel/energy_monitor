node_modules/
build/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example

# Local agent/editor state - keep repository instructions, exclude machine state.
.claude/settings.local.json
.claude/settings.local.*
.claude/local/
.agents/
.codex/

# Vercel project/account binding metadata is workstation-local.
.vercel/

# Local git worktrees (git worktree add) are workstation-local checkouts,
# not application source. Never track them - each is its own branch/repo.
.worktrees/

# Workstation-local skills and packaged skill archives. These remain available
# locally but are not application source.
.claude/skills/
.claude/skills.zip
skills/
skills/**/*.zip

# Temporary, cache, and local database files.
.cache/
.vite/
.tmp/
skills-lock.json
tmp/
work/
*.tmp
*.temp
*.swp
*.swo
*.pid
*.db
*.db-*
*.sqlite
*.sqlite3
*.sqlite-*
*.local
firebase-applet-config.json

# Desktop Google OAuth client credentials (Desktop-app-type client_id/secret
# from Google Cloud Console) - never committed; populate from the .example
# template locally. See docs/GOOGLE_OAUTH_SETUP.md.
google-oauth-desktop-config.json

# Excel owner/lock temp files
~$*
# Electron build output
dist-electron/
release/
# Packaged binaries and generated archives
*.exe
*.msi
*.asar
*.zip

# Backups and generated exports
*.bak
*.backup
# Anchored to the repo root: the Desktop app's local workbook-backup folder
# (D:\...\Energy_Monitor\backup\), not source code. An unanchored "backup/"
# would also match server/backup/ (the new Google Sheets backup service
# source, which must be tracked).
/backup/
exports/
*.export.*
*.test.pdf

# Operational/local workbook data and generated spreadsheet exports
*.xls
*.xlsx
*.xlsm
*.xlsb

# Live workbook database - not source code
RST_Dashboard.xlsm

# Operator scratch files holding live DB connection strings / TLS CA certs
# (never committed - these are pasted in manually for ad-hoc verification).
.phase7-db-url
.phase7-supabase-ca.cer
*.supabase-ca.cer
*-db-url

# Generated at Vercel build time from the tracked server adapter source.
/api/runtime.js
# Portable runtime folders (created beside the exe / project root in dev)
config/
!server/
!server/config/
!server/config/env.ts
logs/
*.appmeta.json
DC_Rangsit.xlsm
DC_Srinakarin.xlsm
.vercel
