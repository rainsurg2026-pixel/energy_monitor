# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Web app configuration used by src/firebaseAuth.ts.
# Populate these values in a local .env.local or CI/build environment.
# They identify the Firebase project; restrict the API key in the provider
# console and never place service-account credentials in this file.
VITE_FIREBASE_API_KEY="replace-with-firebase-web-api-key"
VITE_FIREBASE_AUTH_DOMAIN="replace-with-firebase-auth-domain"
VITE_FIREBASE_PROJECT_ID="replace-with-firebase-project-id"
VITE_FIREBASE_STORAGE_BUCKET="replace-with-firebase-storage-bucket"
VITE_FIREBASE_MESSAGING_SENDER_ID="replace-with-firebase-messaging-sender-id"
VITE_FIREBASE_APP_ID="replace-with-firebase-app-id"
VITE_FIREBASE_MEASUREMENT_ID=""

# PostgreSQL/API server. DATABASE_URL is the runtime transaction-pooler URL.
# DIRECT_DATABASE_URL is for migrations/bootstrap only and must stay server-side.
DATABASE_URL=""
DIRECT_DATABASE_URL=""
NODE_ENV="development"
PORT="3100"
APP_ORIGIN="http://localhost:3000"
APP_ORIGINS="http://localhost:3000"
APP_PREVIEW_ORIGINS=""
TRUST_PROXY="false"
SESSION_SECRET="replace-with-at-least-32-random-server-only-characters"
CSRF_SECRET="replace-with-at-least-32-random-server-only-characters"
SESSION_LIFETIME_MS="28800000"
DB_POOL_MAX="3"
READ_ONLY_MODE="false"

# One-time initial administrator bootstrap. Do not commit real values.
BOOTSTRAP_ADMIN_USERNAME=""
BOOTSTRAP_ADMIN_PASSWORD=""
BOOTSTRAP_ADMIN_DISPLAY_NAME="Energy Monitor Administrator"
