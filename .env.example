# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Web app configuration used by src/firebaseAuth.ts.
# Populate these values in a local .env.local or CI/build environment.
# They identify the Firebase project; restrict the API key in the provider
# console and never place service-account credentials in this file.
VITE_FIREBASE_API_KEY="replace-with-firebase-web-api-key"
VITE_FIREBASE_AUTH_DOMAIN="replace-with-firebase-auth-domain"
VITE_FIREBASE_PROJECT_ID="replace-with-firebase-project-id"
VITE_FIREBASE_STORAGE_BUCKET="replace-with-firebase-storage-bucket"
VITE_FIREBASE_MESSAGING_SENDER_ID="replace-with-firebase-messaging-sender-id"
VITE_FIREBASE_APP_ID="replace-with-firebase-app-id"
VITE_FIREBASE_MEASUREMENT_ID=""

# PostgreSQL/API server. DATABASE_URL is a server-only Supabase Transaction
# Pooler Transaction Mode URL on port 6543 using a dedicated LOGIN role that is
# a NOBYPASSRLS member of energy_monitor_runtime. That group role is NOLOGIN;
# never use postgres/supabase_admin or a direct 5432 URL for the runtime.
# DIRECT_DATABASE_URL is for migrations/bootstrap only and must stay server-side.
# Hosted runtimes require a verified Supabase CA; do not use a VITE_ prefix.
DATABASE_URL=""
DIRECT_DATABASE_URL=""
SUPABASE_DB_CA_CERT=""
# SUPABASE_SERVICE_ROLE_KEY and Storage bucket settings are not required by
# the core Web workflow. Workbook lifecycle and rack-image Storage are deferred.
NODE_ENV="development"
PORT="3100"
APP_ORIGIN="http://localhost:3000"
APP_ORIGINS="http://localhost:3000"
APP_PREVIEW_ORIGINS=""
TRUST_PROXY="false"
SESSION_SECRET="replace-with-at-least-32-random-server-only-characters"
CSRF_SECRET="replace-with-at-least-32-random-server-only-characters"
SESSION_LIFETIME_MS="28800000"
DB_POOL_MAX="3"
READ_ONLY_MODE="false"

# One-time initial administrator bootstrap. Do not commit real values.
BOOTSTRAP_ADMIN_USERNAME=""
BOOTSTRAP_ADMIN_PASSWORD=""
BOOTSTRAP_ADMIN_DISPLAY_NAME="Energy Monitor Administrator"

# --- Preview verification runner only (scripts/test-preview-http.ts) ---
# Not read by the running application - only by `npm run test:preview-http`,
# which exercises an already-deployed Preview over HTTP. Never commit real
# values here or anywhere else. See docs/web-v3/PREVIEW_VERIFICATION.md.
PREVIEW_URL=""
DEV_ADMIN_PASSWORD=""
PREVIEW_UAT_USERNAME="previewuat"
PREVIEW_UAT_PASSWORD=""
# Only needed if PREVIEW_UAT_USERNAME is set to the legacy "usertest" account.
DEV_USER_PASSWORD=""
