{
  "name": "monthly-power-energy-logger",
  "productName": "Data Center Energy & Facility Monitor",
  "description": "Offline-first Windows desktop app for monthly data center power & energy logging, reporting and forecasting, backed by an Excel workbook.",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js --port=3000 --host=0.0.0.0",
    "build": "node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "clean": "rm -rf dist dist-electron release server.js",
    "lint": "node node_modules/typescript/bin/tsc --noEmit -p tsconfig.json && node node_modules/typescript/bin/tsc --noEmit -p tsconfig.electron.json",
    "desktop": "npm run desktop:build && node node_modules/electron/cli.js .",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "desktop:build": "npm run build && node scripts/build-electron.mjs",
    "desktop:package": "npm run desktop:build && node scripts/run-electron-builder.mjs --win --dir",
    "desktop:dist": "npm run desktop:build && node scripts/run-electron-builder.mjs --win"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "firebase": "^12.16.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.9.2",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
